    "paginaPublica": "https://www.reclameaqui.com.br/empresa/tb-finance/"
  },
  "seletores": {
    "loginEmail": "input[type=email], input[name*=email i], input[name*=login i], input[name*=user i]",
    "loginSenha": "input[type=password]",
    "loginBotao": "button[type=submit], button:has-text('Entrar'), button:has-text('Acessar')",
    "linkReclamacao": "a[href*='reclamacao'], a[href*='ticket'], a[href*='complain']",
    "textoReclamacao": "main, [class*=complain i], [class*=ticket i], article",
    "pendente": "text=/não respondida|aguardando resposta|nova reclamação|sem resposta/i",
    "campoResposta": "textarea",
    "botaoEnviarResposta": "button:has-text('Enviar'), button:has-text('Responder'), button:has-text('Publicar')"
  },
  "perfilCampos": {
