{
  "_comentario": "URLs e seletores do painel da empresa no Reclame Aqui. Rode o workflow com modo 'explorar' na primeira vez e ajuste aqui com base nas capturas.",
  "modo": "auto",
  "modelo": "claude-opus-5-5",
  "maxRespostasPorDia": 20,
  "urls": {
